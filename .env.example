# OctoQuiz environment variables
# Copy to .env.local and fill in values

# Socket.IO server URL — leave blank to use same origin (development)
# Set to the Render server URL for Cloudflare Pages deployment
# e.g. https://octoquiz.onrender.com
NEXT_PUBLIC_SOCKET_URL=

# Supabase (AniCal project — used for serverless Realtime fallback if needed)
# NEXT_PUBLIC_SUPABASE_URL=https://seopeujrimwxnuvcbfxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site password (HTTP Basic Auth on Render server — set in Render dashboard)
# SITE_PASSWORD=
