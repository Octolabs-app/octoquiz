{
  "name": "octoquiz",
  "version": "0.2.0",
  "private": true,
  "description": "OctoQuiz — multiplayer party trivia by Octolabs",
  "homepage": "https://octoquiz.octolabs.app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "lint": "eslint .",
    "apk:export": "node scripts/build-apk.mjs",
    "apk:init": "npx cap add android",
    "apk:sync": "npm run apk:export && npx cap sync android",
    "apk:open": "npx cap open android",
    "apk:build": "npm run apk:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "next": "^16.2.9",
    "qrcode.react": "^4.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "postcss": "8.5.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.97.0"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
